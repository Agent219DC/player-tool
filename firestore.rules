rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() == 'agent219dc@gmail.com'; }
    function isStaff() {
      return isOwner() || (signedIn()
        && exists(/databases/$(database)/documents/config/staff)
        && email() in get(/databases/$(database)/documents/config/staff).data.emails);
    }

    // The position boards staff work in
    function isBoard(c) {
      return c in ['qb_players', 'rb_players', 'wr_players', 'te_players', 'iol_players', 'ot_players',
                   'dt_players', 'de_players', 'lb_players', 'saf_players', 'cb_players', 'hs_players'];
    }

    // Model settings: staff read, owner writes. Staff list, market prices and backup log: owner only.
    match /config/{doc} {
      allow read: if isOwner() || (isStaff() && !(doc in ['staff', 'market', 'backup', 'rollover']));
      allow write: if isOwner();
    }
    // Staff read everything here (depth charts feed the starters); staff only write games played (season).
    // Depth charts are GM side: only the owner changes them.
    match /shared/{doc} {
      allow read: if isStaff();
      allow write: if isOwner() || (isStaff() && doc == 'season');
    }
    // Display names for "updated by" lines
    match /users/{uid} {
      allow read: if isStaff();
      allow write: if isStaff() && request.auth.uid == uid;
    }
    // Analytics (Sun Belt snapshot and two-deeps, no money): staff read, owner writes
    match /analytics/{doc} {
      allow read: if isStaff();
      allow write: if isOwner();
    }
    // Budget and what we pay our players: owner only, nobody else can read it
    match /owner/{doc} {
      allow read, write: if isOwner();
    }
    // Position boards: staff add and edit; only the owner deletes a player for good (the site's Delete is a soft delete).
    // Any other collection (old copies such as sbc_players): owner only.
    match /{coll}/{doc} {
      allow read, create, update: if isStaff() && isBoard(coll);
      allow delete: if isOwner() && isBoard(coll);
      allow read: if isOwner();
    }
  }
}
